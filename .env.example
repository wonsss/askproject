# Claude
# LLM 인증 경로: api(기본, 아래 키로 직접 호출) | subscription(로컬 claude CLI 구독 로그인 — 로컬 PoC 전용)
ASKPROJECT_LLM_PROVIDER=api
ANTHROPIC_API_KEY=
ASKPROJECT_MODEL_LARGE=claude-sonnet-5-5
ASKPROJECT_MODEL_SMALL=claude-haiku-5-5
# 에이전트 effort (low|medium|high|xhigh|max). 비우면 모델 기본값(sonnet-5-5 high, haiku-5-5 medium)
ASKPROJECT_AGENT_EFFORT_LARGE=
ASKPROJECT_AGENT_EFFORT_SMALL=
ASKPROJECT_AGENT_MAX_TURNS=12
ASKPROJECT_AGENT_MAX_BUDGET_USD=0.5

# GitHub App (권장): Contents·Metadata 읽기 전용, 대상 레포에만 설치
ASKPROJECT_GITHUB_APP_ID=
ASKPROJECT_GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
ASKPROJECT_GITHUB_APP_INSTALLATION_ID=
# 또는 fine-grained PAT (contents: read, 고른 레포만). 공개 레포면 비워 둬도 됨
ASKPROJECT_GITHUB_TOKEN=

# Slack (Socket Mode)
ASKPROJECT_SLACK_BOT_TOKEN=xoxb-
ASKPROJECT_SLACK_APP_TOKEN=xapp-
# '개발자에게 확인 요청' 버튼이 글을 올릴 채널 ID (선택)
ASKPROJECT_ESCALATION_CHANNEL=
# 봇이 답할 채널 ID (쉼표 구분, DM 허용은 dm). 비우면 봇이 초대된 모든 채널 — 코드 내용이 그 채널 전원에게 보인다
ASKPROJECT_ALLOWED_CHANNELS=
# 호스트 하트비트 채널 ID (같은 슬랙 앱으로 봇이 두 대 켜지는 것 감지). 비우면 ESCALATION_CHANNEL
ASKPROJECT_HOST_CHANNEL=
# 소스로 읽을 공개 채널 ID (쉼표 구분, 선택) · 기간(일)
ASKPROJECT_SLACK_SOURCE_CHANNELS=
ASKPROJECT_SLACK_SOURCE_DAYS=90

# Notion (봇 전용 내부 통합, 콘텐츠 읽기만) — 선택
ASKPROJECT_NOTION_TOKEN=
ASKPROJECT_NOTION_ROOT_PAGE_ID=

# 저장 위치 (레포 사본·로그는 비우면 DATA_DIR 아래)
ASKPROJECT_DATA_DIR=./data
ASKPROJECT_CACHE_DIR=
ASKPROJECT_LOG_DIR=

# DB 백업 (docs/operations.md). 감사 로그는 영구 보존, 로컬 백업 파일만 보관 일수가 지나면 정리
ASKPROJECT_BACKUP_DIR=./backups
ASKPROJECT_BACKUP_KEEP_DAYS=14
# 서버 밖 복사 명령. {file}이 백업 파일 경로로 바뀐다. 예: rclone copy {file} r2:askproject-backups
ASKPROJECT_BACKUP_UPLOAD_CMD=

# 맥북 호스트 모드 절전 정책: default(맥과 같이 잠듦) | lid-open(덮개 열린 동안 깨어 있음, 기본) | lid-closed(전원 연결 시 덮개 닫아도 깨어 있음)
ASKPROJECT_POWER_MODE=lid-open
